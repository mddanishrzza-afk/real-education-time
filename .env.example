# Production database: pooled URL for runtime and direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST:5432/real_education_time?sslmode=require&schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/real_education_time?sslmode=require&schema=public"

# Public application origin and secure session settings.
APP_URL="https://your-domain.example"
SESSION_COOKIE_NAME="ret_session"

# Upstash-compatible Redis REST (required in production; rate limiting fails closed).
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare Turnstile (both are required in production).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Provider-neutral transactional email; public MVP initially uses Resend.
EMAIL_PROVIDER="RESEND"
EMAIL_FROM="Real Education Time <no-reply@your-domain.example>"
RESEND_API_KEY=""

# Vercel Cron authenticates cleanup requests with this long random secret.
CRON_SECRET=""

# Automatic one-time payments (optional). Leave all three RAZORPAY_* variables unset
# to run in manual-UPI-only mode: checkout then fails closed and students pay through
# the UPI QR flow, which is reviewed in /admin/payments. After merchant KYC completes,
# set live keys (rzp_live_...); rzp_test_ keys are rejected on a production deployment.
PAYMENT_PROVIDER=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Manual UPI fallback. It is reviewed by an administrator and never auto-unlocks access.
# PAYMENT_QR_URI is the exact upi://pay? string the payment app produced (lost the string? scan the
# QR with any UPI app and copy the decoded payload). Students scan a QR rendered live from this
# value at /payment/qr — no QR image is stored in the repository, so the code can never point at a
# different recipient than the UPI id printed next to it. Anything unexpected in the string makes
# the destination fail closed: the app then shows no QR and no UPI id at all.
PAYMENT_QR_URI=""
# Optional one-line reassurance shown under the QR (max 160 characters).
PAYMENT_QR_NOTE=""
# Older id + name pair, kept as a fallback while PAYMENT_QR_URI is empty.
MANUAL_UPI_ID=""
MANUAL_UPI_NAME=""
# Optional manual NEFT/IMPS bank transfer (net banking) destination. Fill all four to
# switch the bank-transfer option on; while they are empty the access center explains
# that bank transfer and automatic net banking arrive with the payment gateway.
BANK_ACCOUNT_NAME=""
BANK_ACCOUNT_NUMBER=""
BANK_IFSC=""
BANK_NAME=""

# Public production safety switches. Keep both false.
ENABLE_DEMO_LOGIN="false"
SEED_DEMO_DATA="false"

# Phase 2 AI provider abstraction (never expose this to the browser).
# Supported values: MESH (Mesh API gateway), OPENAI_COMPATIBLE, GEMINI, or LOCAL_GROUNDED.
# Without a cloud key, the tutor uses clearly-labelled approved-content mode.
AI_PROVIDER="LOCAL_GROUNDED"
AI_API_KEY=""
AI_MODEL=""
AI_BASE_URL=""
AI_TIMEOUT_MS="20000"

# Optional: configure a Vercel log drain / monitoring integration in the platform.
SENTRY_DSN=""

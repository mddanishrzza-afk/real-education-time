{
  "name": "real-education-time",
  "version": "0.1.0",
  "private": true,
  "description": "AI-ready adaptive education platform for Indian school boards and competitive exams.",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:production": "npm run db:generate:production && next build --webpack",
    "vercel-build": "npm run env:validate:production && npm run db:generate:production && npm run db:migrate:deploy && node scripts/fail-if-migrate-pending.mjs && node scripts/maybe-seed.mjs && node scripts/promote-admin.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:public": "node scripts/public-mvp-smoke.cjs",
    "test:e2e:login-otp": "node scripts/login-otp-smoke.cjs",
    "test:e2e:access": "node scripts/access-payment-smoke.cjs",
    "test:e2e:interaction": "node scripts/interaction-smoke.cjs",
    "test:ai:live": "MESH_LIVE_TEST=1 vitest run src/lib/ai/mesh.live.test.ts",
    "env:validate:production": "node scripts/validate-env.mjs",
    "android:configure": "node scripts/configure-android-twa.mjs",
    "android:update": "cd android && npx --yes @bubblewrap/cli@1.25.0 update --skipVersionUpgrade",
    "android:build": "cd android && npx --yes @bubblewrap/cli@1.25.0 build",
    "db:generate": "prisma generate --schema prisma/schema.sqlite.prisma",
    "db:generate:production": "prisma generate --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.sqlite.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "SEED_DEMO_DATA=true tsx prisma/seed.ts",
    "db:seed:production": "SEED_DEMO_DATA=false tsx prisma/seed.ts",
    "db:setup": "npm run db:generate && npm run db:push && npm run db:seed:demo",
    "db:setup:content": "npm run db:generate && npm run db:push && npm run db:seed",
    "db:studio": "prisma studio --schema prisma/schema.sqlite.prisma",
    "test:e2e:analysis": "node scripts/attempt-analysis-smoke.cjs",
    "test:e2e:netbanking": "node scripts/netbanking-smoke.cjs",
    "test:e2e:honesty": "node scripts/payment-honesty-smoke.cjs",
    "test:e2e:certificate": "node scripts/certificate-smoke.cjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "html2canvas-pro": "^2.5.0",
    "jspdf": "^4.2.1",
    "lucide-react": "0.468.0",
    "next": "16.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.15.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "jsqr": "^1.4.0",
    "playwright": "^1.62.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vitest": "4.1.10"
  }
}

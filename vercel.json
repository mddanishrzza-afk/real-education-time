{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run vercel-build",
  "functions": {
    "src/app/api/v1/doubts/**/*.ts": {
      "maxDuration": 30
    },
    "src/app/api/v1/auth/**/*.ts": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/internal/cron/cleanup",
      "schedule": "17 2 * * *"
    }
  ]
}
